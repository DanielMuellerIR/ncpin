#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
ncpin — Nextcloud-VFS-Pin per Kommandozeile setzen.

Hintergrund (für Einsteiger):
  Der Nextcloud-Desktop-Client kann Dateien "virtuell" halten (Virtual Files /
  VFS, hier im "suffix"-Modus). Eine online-only Datei liegt lokal nur als
  winziger Platzhalter "<name>.nextcloud" (1 Byte). Holt man sie lokal
  ("hydrieren"), wird daraus die echte Datei "<name>".

  Im Finder macht das normalerweise das Rechtsklick-Menü der FinderSync-
  Extension ("Immer lokal verfügbar machen" / "Lokalen Speicherplatz
  freigeben"). Diese Extension lässt sich auf manchen macOS-Versionen nicht
  aktivieren — dann fehlt das Menü. ncpin bietet denselben Schalter headless.

ncpin kennt zwei Transporte und wählt automatisch:

1. Socket-Transport (Client bis v33): Der laufende Client bietet einen lokalen
   Unix-Socket an; ncpin schickt exakt dieselben Befehle wie die FinderSync-
   Extension. Zeilenbasiertes UTF-8-Protokoll, je Befehl mit "\\n":
     MAKE_AVAILABLE_LOCALLY:<absoluter pfad>   -> hydrieren ("immer lokal")
     MAKE_ONLINE_ONLY:<absoluter pfad>         -> dehydrieren (Platz freigeben)
     GET_MENU_ITEMS:<absoluter pfad>           -> liefert u.a. den Ist-Zustand
   Beim Verbinden schickt der Server zuerst "REGISTER_PATH:<sync-ordner>".

2. Rename-Transport (Client ab v34): v34 hat die Socket-API auf macOS entfernt
   (der Finder spricht seitdem XPC, dort lässt der Client nur Prozesse mit
   Nextclouds Team-ID zu). Die Sync-Engine liest Pin-Wünsche im suffix-Modus
   aber weiterhin aus dem Dateisystem (nextcloud/desktop,
   src/libsync/discovery.cpp):
     "<name>.nextcloud" -> "<name>" umbenennen   => Datei wird heruntergeladen
     "<name>" -> "<name>.nextcloud" umbenennen   => Datei wird dehydriert,
       sofern sie fertig gesynct ist (mtime+Größe müssen zum Journal passen)
   ncpin nutzt genau diese Mechanik: Aktion = os.rename, den Sync stößt der
   Dateiwächter des Clients selbst an. Der Zustand kommt direkt aus dem
   Dateisystem, die Syncwurzeln aus der nextcloud.cfg des Clients, und vor
   einer Dehydrierung prüft ncpin gegen das Sync-Journal, dass die Datei
   fertig hochgeladen ist (sonst würde der Client den Wunsch still ignorieren).

Headless/AI-Agent (maschinenlesbar):
  ncpin status --json <pfad>     -> JSON je Pfad, Exit-Code spricht Bände
  Exit-Codes: 0 ok | 1 Laufzeitfehler (kein Client/Transport, Wait-Timeout)
              | 2 Aufruf-Fehler
              | 3 ein/mehrere Pfade nicht gefunden oder nicht im Nextcloud-Ordner
"""

import argparse
import glob
import json
import os
import plistlib
import re
import socket
import stat
import sys
import time

# Standard-Suffix der virtuellen Platzhalter. Nextcloud-Branding = ".nextcloud",
# ownCloud = ".owncloud". Per Umgebungsvariable überschreibbar.
SUFFIX = os.environ.get("NCPIN_SUFFIX", ".nextcloud")

# Wartebudgets (Sekunden) fuer das Lesen einer Server-Antwort.
#
# Das Nicht-Offensichtliche (war die eigentliche Latenz-Ursache, ~3s pro Aufruf):
# Der Client schickt seine Antwort (Handshake-Zeilen bzw. Menue) als EINEN kurzen
# Burst und haelt die Verbindung danach offen, ohne weiterzusenden. Ein fixes
# recv() blockiert dann bis zum Socket-Timeout (3s) — nicht bis HANDSHAKE_WAIT.
# Loesung (_recv_burst): auf das erste Paket bis HANDSHAKE_WAIT warten, danach nur
# noch eine kurze Idle-Spanne (RECV_IDLE) auf Nachzuegler; bleibt es still, ist der
# Server fertig -> abbrechen. RECV_MAX ist nur ein Sicherheitsnetz gegen Haenger.
HANDSHAKE_WAIT = 0.6   # max. Wartezeit auf das ERSTE Antwort-Paket
RECV_IDLE = 0.1        # "Server fertig"-Luecke: so lange ohne neue Daten -> Ende
                       #   (Burst-Pakete am Connect kommen ~gleichzeitig; 0,1s
                       #    faengt auch mehrere Sync-Ordner sicher mit ein)
RECV_MAX = 3.0         # harte Obergrenze pro Lesevorgang


# ---------------------------------------------------------------------------
# Socket finden + ansprechen
# ---------------------------------------------------------------------------

def _socket_candidates(override=None):
    """Liefert strikte explizite oder automatisch gefundene Kandidaten."""
    if override is not None:
        return [override]
    env = os.environ.get("NCPIN_SOCKET")
    if env:
        return [env]

    home = os.path.expanduser("~")
    gc = os.path.join(home, "Library", "Group Containers")
    candidates = sorted(glob.glob(
        os.path.join(gc, "*.com.nextcloud.desktopclient", "s")))
    candidates.append(os.path.join(
        gc, "com.nextcloud.desktopclient", ".socket"))
    return candidates


def _is_unix_socket(path):
    """Prueft den Dateityp; Existenz allein reicht bei stale Pfaden nicht."""
    try:
        return stat.S_ISSOCK(os.stat(path).st_mode)
    except (OSError, TypeError, ValueError):
        return False


def discover_socket_with_paths(override=None):
    """Findet einen echten Socket mit erfolgreichem REGISTER_PATH-Handshake.

    Reihenfolge:
      1. --socket / NCPIN_SOCKET (explizit gesetzt)
      2. Team-präfixierter Group-Container (der Live-Socket des Clients): .../s
      3. Legacy-Pfad ohne Team-Präfix: .../.socket

    Explizite Pfade sind strikt: Ist ihr Socket stale oder antwortet nicht,
    wird nicht auf einen automatisch gefundenen Kandidaten ausgewichen.
    """
    for candidate in _socket_candidates(override):
        if not _is_unix_socket(candidate):
            continue
        roots = read_registered_paths(candidate)
        if roots:
            return candidate, roots
    return None, []


def discover_socket(override=None):
    """Kompatibler Kurzweg: nur den verifizierten Socket-Pfad liefern."""
    sock_path, _roots = discover_socket_with_paths(override)
    return sock_path


def installed_client_version():
    """Version des installierten Nextcloud-Desktop-Clients oder None.

    Liest CFBundleShortVersionString direkt aus der Info.plist des
    App-Bundles, ohne den Client zu starten. plistlib gehört zur
    Standardbibliothek und funktioniert im System-Python.
    """
    for app_dir in ("/Applications/Nextcloud.app",
                    os.path.expanduser("~/Applications/Nextcloud.app")):
        plist_path = os.path.join(app_dir, "Contents", "Info.plist")
        try:
            with open(plist_path, "rb") as fh:
                info = plistlib.load(fh)
        except (OSError, ValueError):
            # App fehlt an diesem Ort oder die Plist ist unlesbar -> naechster.
            continue
        version = info.get("CFBundleShortVersionString")
        if isinstance(version, str) and version:
            return version
    return None


def socket_api_removed_hint():
    """Erklärung, falls der Client keine Socket-API hat UND der Rename-
    Transport nicht greift (keine suffix-Ordner in der Config gefunden).

    Der Desktop-Client 34.0.0 (Juli 2026) hat die lokale Socket-API auf
    macOS ersatzlos entfernt: Der Finder spricht seitdem über XPC, und der
    Client akzeptiert dort nur Prozesse mit Nextclouds eigener Team-ID.
    ncpin steuert solche Clients stattdessen über den Rename-Transport —
    der braucht aber mindestens einen Sync-Ordner im suffix-VFS-Modus.

    Liefert den erklärenden Text oder None (Client unbekannt oder < 34).
    """
    version = installed_client_version()
    if not version:
        return None
    try:
        major = int(version.split(".")[0])
    except ValueError:
        return None
    if major < 34:
        return None
    config = find_client_config()
    return ("Nextcloud-Client %s besitzt keine lokale Socket-API mehr "
            "(seit v34 nur noch XPC für Nextcloud-eigene Prozesse). "
            "ncpin nutzt dann den Rename-Transport; dafür braucht die "
            "Client-Konfiguration mindestens einen Sync-Ordner mit "
            "virtualFilesMode=suffix. Geprüfte Konfiguration: %s."
            % (version, config or "nicht gefunden"))


def _connect(sock_path):
    """Verbindet sich mit dem Unix-Socket, wirft bei Fehler."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(3.0)
    try:
        s.connect(sock_path)
    except OSError:
        s.close()
        raise
    return s


def _recv_burst(s, first_wait, sentinel=None):
    """Liest die Server-Antwort von einem (frisch verbundenen) Socket.

    Der Client antwortet als kurzer Burst und schweigt danach, haelt die
    Verbindung aber offen. Darum NICHT auf ein festes Zeitfenster warten:
      - auf das ERSTE Paket bis 'first_wait' Sekunden warten,
      - danach je 'RECV_IDLE' Sekunden auf Nachzuegler; kommt nichts mehr
        (socket.timeout), ist der Server fertig -> abbrechen,
      - bei gesetztem 'sentinel' sofort abbrechen, sobald er im Puffer steht
        (z.B. b"GET_MENU_ITEMS:END") -> spart die Idle-Wartezeit ganz.
    'RECV_MAX' deckelt den Gesamt-Lesevorgang (Sicherheitsnetz gegen Haenger).
    Gibt den Roh-Text (UTF-8, fehlertolerant) zurueck.
    """
    buf = b""
    deadline = time.time() + RECV_MAX
    first = True
    while time.time() < deadline:
        # erstes Paket darf laenger dauern (Client evtl. kurz beschaeftigt),
        # danach reicht die kurze Idle-Luecke, um "fertig" zu erkennen.
        s.settimeout(first_wait if first else RECV_IDLE)
        try:
            data = s.recv(65536)
        except socket.timeout:
            break
        first = False
        if not data:
            break
        buf += data
        if sentinel and sentinel in buf:
            break
    return buf.decode("utf-8", "replace")


def read_registered_paths(sock_path):
    """Liest die REGISTER_PATH-Zeilen, die der Server beim Verbinden schickt.

    Gibt die Liste der synchronisierten Wurzel-Ordner zurück (z.B.
    ["/Users/.../Nextcloud"]). Damit prüfen wir, ob ein Zielpfad überhaupt
    in einem Nextcloud-Ordner liegt.
    """
    paths = []
    try:
        s = _connect(sock_path)
    except OSError:
        return paths
    try:
        # Kein Sentinel: der Server markiert das Ende der REGISTER_PATH-Zeilen
        # nicht. _recv_burst erkennt das Ende an der Idle-Luecke nach dem Burst
        # (frueher blockierte hier ein zweites recv bis zum 3s-Socket-Timeout).
        text = _recv_burst(s, HANDSHAKE_WAIT)
        for line in text.splitlines():
            if line.startswith("REGISTER_PATH:"):
                registered = line[len("REGISTER_PATH:"):]
                if registered:
                    paths.append(registered)
    except OSError:
        # Verbindungsreset o.ae. mitten im Handshake: Kandidat wie einen toten
        # Socket behandeln (leere Liste). Die Discovery prueft dann den
        # naechsten Kandidaten; ein expliziter Socket endet kontrolliert mit
        # "kein Transport" statt mit einem Traceback.
        return []
    finally:
        s.close()
    return paths


def send_command(sock_path, command, read_secs=0.0):
    """Schickt einen einzelnen Befehl und liest optional die Antwort.

    read_secs=0 -> nur senden (für MAKE_*; der Server antwortet darauf nicht).
    read_secs>0 -> Antwort lesen; read_secs ist die max. Wartezeit auf das ERSTE
                   Antwort-Paket (danach uebernimmt die Idle-Logik in _recv_burst).
                   Bei GET_MENU_ITEMS bricht der b"GET_MENU_ITEMS:END"-Sentinel
                   sofort ab -> in der Praxis ~0,03s statt der vollen read_secs.
    """
    s = _connect(sock_path)
    try:
        s.sendall((command + "\n").encode("utf-8"))
        if read_secs <= 0:
            # Kurz warten, damit der Schreibpuffer sicher raus ist, dann zu.
            time.sleep(0.15)
            return ""
        return _recv_burst(s, read_secs, sentinel=b"GET_MENU_ITEMS:END")
    finally:
        s.close()


# ---------------------------------------------------------------------------
# Pfad-Auflösung + Zustands-Abfrage
# ---------------------------------------------------------------------------

def resolve_ondisk(path):
    """Findet den tatsächlichen On-Disk-Namen einer (evtl. virtuellen) Datei.

    Der Nutzer tippt vielleicht "Foo.mp4", auf der Platte liegt aber
    "Foo.mp4.nextcloud" (dehydriert) — oder umgekehrt. Wir probieren:
      1. den Pfad selbst
      2. Pfad + Suffix   (Nutzer meinte die virtuelle Datei, sie ist dehydriert)
      3. Pfad − Suffix   (Nutzer gab den .nextcloud-Namen, Datei ist hydriert)
    Gibt den existierenden Pfad zurück, sonst None.
    """
    p = os.path.abspath(os.path.expanduser(path))
    if os.path.lexists(p):
        return p
    if os.path.lexists(p + SUFFIX):
        return p + SUFFIX
    if p.endswith(SUFFIX) and os.path.lexists(p[:-len(SUFFIX)]):
        return p[:-len(SUFFIX)]
    return None


def parse_state(menu_text):
    """Ermittelt den Ist-Pin-Zustand aus einer GET_MENU_ITEMS-Antwort.

    Lokalisierungs-unabhängig: wir schauen NICHT auf die Labels, sondern darauf,
    welche Aktion aktiv (klickbar) ist. Das Flag-Feld "d" bedeutet "disabled".
      Format je Zeile: MENU_ITEM:<befehl>:<flags>:<titel>
      - MAKE_AVAILABLE_LOCALLY aktiv  -> Datei ist gerade online-only  -> "online"
      - MAKE_ONLINE_ONLY aktiv        -> Datei ist gerade lokal         -> "local"

    "Zeile fehlt" ist dabei NICHT dasselbe wie "vorhanden, aber disabled":
    Ein abgebrochener Burst kann eine der beiden Menuezeilen verlieren. Nur
    wenn beide Command-IDs gesehen wurden, ist die Antwort vollstaendig genug
    fuer eine Zustandsaussage — sonst ehrlich "unknown" (toggle bricht dann ab,
    statt aufgrund einer halben Antwort eine Gegenaktion zu senden).
    """
    avail_seen = online_seen = False
    avail_enabled = online_enabled = False
    for line in menu_text.splitlines():
        if not line.startswith("MENU_ITEM:"):
            continue
        parts = line.split(":")
        # parts[1] = Befehl, parts[2] = Flags
        if len(parts) < 3:
            continue
        cmd, flags = parts[1], parts[2]
        enabled = "d" not in flags  # 'd' => disabled
        if cmd == "MAKE_AVAILABLE_LOCALLY":
            avail_seen = True
            avail_enabled = enabled
        elif cmd == "MAKE_ONLINE_ONLY":
            online_seen = True
            online_enabled = enabled
    if not (avail_seen and online_seen):
        return "unknown"
    if online_enabled and not avail_enabled:
        return "local"
    if avail_enabled and not online_enabled:
        return "online"
    return "unknown"


def query_state(sock_path, ondisk_path, roots):
    """Fragt den Pin-Zustand ab, nach erneutem Check der Sync-Grenze."""
    ondisk_path = checked_path(ondisk_path, roots)
    # read_secs ist nur noch die Wartezeit auf das ERSTE Paket; der
    # GET_MENU_ITEMS:END-Sentinel beendet das Lesen real nach ~0,03s.
    text = send_command(sock_path, "GET_MENU_ITEMS:" + ondisk_path, read_secs=1.0)
    return parse_state(text)


# ---------------------------------------------------------------------------
# Aktionen
# ---------------------------------------------------------------------------

CMD_LOCAL = "MAKE_AVAILABLE_LOCALLY"   # hydrieren / "immer lokal" (pin)
CMD_ONLINE = "MAKE_ONLINE_ONLY"        # dehydrieren / Speicher freigeben


def do_action(sock_path, ondisk_path, target, roots):
    """Schickt den Pin-Befehl nach erneutem Check der Sync-Grenze."""
    ondisk_path = checked_path(ondisk_path, roots)
    cmd = CMD_LOCAL if target == "local" else CMD_ONLINE
    send_command(sock_path, cmd + ":" + ondisk_path, read_secs=0.0)


def wait_for_state(sock_path, orig_path, target, timeout, roots):
    """Pollt, bis der Zielzustand erreicht ist oder timeout abläuft.

    Wichtig: beim Hydrieren/Dehydrieren ändert sich der On-Disk-Name (Suffix
    kommt/geht), daher in jeder Runde neu auflösen.
    """
    start = time.time()
    while time.time() - start < timeout:
        od = resolve_ondisk(orig_path)
        if od is None:
            time.sleep(0.5)
            continue
        st = query_state(sock_path, od, roots)
        if st == target:
            return True
        time.sleep(0.5)
    return False


# ---------------------------------------------------------------------------
# Rename-Transport (Client v34+ ohne Socket-API)
# ---------------------------------------------------------------------------
#
# Grundidee (siehe Modul-Doku oben): Die Sync-Engine behandelt im suffix-Modus
# zwei Umbenennungen als Pin-Wunsch. ncpin macht also nur noch os.rename und
# überlässt Download/Dehydrierung dem Client selbst. Drei Bausteine:
#   1. Syncwurzeln aus der nextcloud.cfg lesen (ersetzt REGISTER_PATH),
#   2. Zustand direkt vom Dateisystem lesen (ersetzt GET_MENU_ITEMS) —
#      ein Platzhalter ist "<name>.nextcloud" mit exakt 1 Byte, dieselbe
#      Heuristik verwendet die Engine selbst (discovery.cpp),
#   3. vor einer Dehydrierung gegen das Sync-Journal (SQLite) prüfen, dass
#      die Datei fertig gesynct ist — sonst ignoriert der Client den Wunsch
#      still und es bliebe eine verwirrende "<name>.nextcloud" mit Vollinhalt.

CONFIG_ENV = "NCPIN_CONFIG"      # Config-Pfad für Tests überschreibbar
PLACEHOLDER_SIZE = 1             # Größe eines dehydrierten Platzhalters (Byte)
FOLDER_SCAN_CAP = 512            # Stichproben-Deckel für Ordner-Zustand

# Sync-Ordner-Schlüssel in der nextcloud.cfg (QSettings-Format), z.B.:
#   0\FoldersWithPlaceholders\1\localPath=/Users/x/Nextcloud/
#   0\FoldersWithPlaceholders\1\virtualFilesMode=suffix
#   0\FoldersWithPlaceholders\1\journalPath=.sync_abc.db
_FOLDER_KEY_RE = re.compile(
    r"^(\d+)\\(Folders(?:WithPlaceholders)?)\\([^\\]+)\\"
    r"(localPath|virtualFilesMode|journalPath)$")


def _config_candidates():
    """Mögliche Orte der nextcloud.cfg (Testoverride zuerst, dann sandboxed)."""
    env = os.environ.get(CONFIG_ENV)
    if env:
        return [env]
    home = os.path.expanduser("~")
    return [
        # Sandboxed App-Store-/Standard-Build: Container-Pfad.
        os.path.join(home, "Library", "Containers", "com.nextcloud.desktopclient",
                     "Data", "Library", "Preferences", "Nextcloud", "nextcloud.cfg"),
        # Klassischer (nicht-sandboxed) Pfad als Fallback.
        os.path.join(home, "Library", "Preferences", "Nextcloud", "nextcloud.cfg"),
    ]


def find_client_config():
    """Liefert den Pfad der ersten vorhandenen nextcloud.cfg oder None."""
    for candidate in _config_candidates():
        if os.path.isfile(candidate):
            return candidate
    return None


def parse_client_folders(cfg_path):
    """Liest die Sync-Ordner-Definitionen aus der nextcloud.cfg.

    Bewusst ein minimaler Zeilenparser statt configparser: QSettings-Dateien
    enthalten Schlüssel mit Backslashes und Prozent-Escapes, an denen sich
    configparser verschluckt. Wir brauchen nur drei bekannte Schlüssel je
    Ordner. Gibt eine Liste von Dicts:
      {"path": <localPath ohne Slash am Ende>, "vfs_mode": <str>, "journal": <str|None>}
    """
    folders = {}
    try:
        with open(cfg_path, "r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("[") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                match = _FOLDER_KEY_RE.match(key.strip())
                if not match:
                    continue
                ident = (match.group(1), match.group(2), match.group(3))
                folder = folders.setdefault(ident, {})
                folder[match.group(4)] = value.strip().strip('"')
    except OSError:
        return []
    result = []
    for folder in folders.values():
        local_path = folder.get("localPath")
        if not local_path:
            continue
        result.append({
            "path": local_path.rstrip("/") or "/",
            "vfs_mode": folder.get("virtualFilesMode", "off"),
            "journal": folder.get("journalPath") or None,
        })
    return result


def rename_transport_context():
    """Baut den Kontext des Rename-Transports oder None.

    None heißt: keine Config gefunden oder kein einziger Ordner im
    suffix-Modus — dann kann ncpin diesen Client nicht steuern.
    """
    config = find_client_config()
    if not config:
        return None
    folders = parse_client_folders(config)
    suffix_folders = [f for f in folders if f["vfs_mode"] == "suffix"]
    if not suffix_folders:
        return None
    return {
        "config": config,
        "folders": suffix_folders,
        "roots": [f["path"] for f in suffix_folders],
        "journal_cache": {},
    }


def client_process_running():
    """True, wenn ein Desktop-Client-Prozess läuft (Nextcloud oder ownCloud).

    Der Rename-Transport braucht keinen Socket, aber ohne laufenden Client
    würde die Umbenennung erst irgendwann später verarbeitet — für den
    CLI-Vertrag (Exit 1 bei "Client fehlt") prüfen wir das explizit.
    """
    import subprocess
    for name in ("Nextcloud", "ownCloud"):
        try:
            probe = subprocess.run(
                ["/usr/bin/pgrep", "-x", name],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            # pgrep fehlt (sehr unwahrscheinlich): Operation nicht blockieren.
            return True
        if probe.returncode == 0:
            return True
    return False


def fs_file_state(ondisk):
    """Zustand einer Datei direkt vom Dateisystem.

    Grenzfall wie in der Engine selbst (discovery.cpp: "This check leaks some
    details of VfsSuffix, particularly the size of placeholders"): eine echte
    Datei mit exakt 1 Byte ist von einem frisch für den Download umbenannten
    Platzhalter nicht unterscheidbar und wird als "online" gemeldet. Genau
    dadurch wartet --wait beim Hydrieren korrekt, bis der Inhalt wirklich da ist.
    """
    try:
        size = os.stat(ondisk).st_size
    except OSError:
        return "unknown"
    if ondisk.endswith(SUFFIX):
        # Der Vertrag verlangt EXAKT 1 Byte. Ein Platzhalter mit Vollinhalt
        # (>1 Byte) wäre ein ignorierter Dehydrierungswunsch, eine leere Datei
        # (0 Byte) Datenmüll -> beides ehrlich "unknown".
        return "online" if size == PLACEHOLDER_SIZE else "unknown"
    return "online" if size == PLACEHOLDER_SIZE else "local"


def fs_folder_state(folder, exact=False):
    """Aggregierter Zustand eines Ordners (rekursiv, mit frühem Ausstieg).

    - nur lokale Dateien gesehen  -> "local"
    - nur Platzhalter gesehen     -> "online"
    - Mischung oder leer          -> "unknown" (wie das Socket-Menü früher)

    exact=False (Anzeige-Stichprobe): Der Deckel FOLDER_SCAN_CAP hält den
    Aufruf auch bei riesigen Bäumen schnell, und einzelne "unknown"-Dateien
    werden übergangen — reicht für eine unverbindliche Statuszeile.
    exact=True (Entscheidungsgrundlage für toggle und --wait): vollständige
    Traversierung ohne Deckel, und jede "unknown"-Datei macht den ganzen
    Ordner "unknown" — eine Stichprobe könnte sonst einen gemischten Baum
    als einheitlich melden und toggle in die falsche Richtung schicken.
    Ebenso zählt im exakten Modus jeder Scanfehler: os.walk übergeht einen
    nicht lesbaren Unterordner sonst STILL, und ein Baum mit unsichtbarem
    Platzhalter darunter käme fälschlich als einheitlich "local" heraus.
    """
    seen_local = seen_online = False
    scanned = 0
    # onerror sammelt die Fehler nur ein; entschieden wird am Ende (siehe unten).
    scan_errors = []
    walker = (os.walk(folder, onerror=scan_errors.append) if exact
              else os.walk(folder))
    for dirpath, dirnames, filenames in walker:
        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        for name in filenames:
            if name.startswith("."):
                continue
            state = fs_file_state(os.path.join(dirpath, name))
            if state == "local":
                seen_local = True
            elif state == "online":
                seen_online = True
            elif exact:
                # z.B. Platzhalter mit falscher Größe: Zustand unklar.
                return "unknown"
            if seen_local and seen_online:
                return "unknown"
            if not exact:
                scanned += 1
                if scanned >= FOLDER_SCAN_CAP:
                    break
        if not exact and scanned >= FOLDER_SCAN_CAP:
            break
    if scan_errors:
        # Ein Teilbaum blieb ungelesen -> der Gesamtzustand ist NICHT bekannt.
        return "unknown"
    if seen_local != seen_online:
        return "local" if seen_local else "online"
    return "unknown"


def rename_query_state(ondisk, roots, exact=False):
    """Pendant zu query_state() für den Rename-Transport (rein lesend).

    exact=True erzwingt bei Ordnern die vollständige Traversierung (siehe
    fs_folder_state) — Pflicht für toggle und --wait.
    """
    ondisk = checked_path(ondisk, roots)
    if os.path.isdir(ondisk):
        return fs_folder_state(ondisk, exact=exact)
    return fs_file_state(ondisk)


def _suffix_folder_for(path, rename_ctx):
    """Findet den suffix-Sync-Ordner, in dem der (kanonische) Pfad liegt."""
    candidate = canonical_path(path)
    for folder in rename_ctx["folders"]:
        root = canonical_path(folder["path"])
        try:
            if os.path.commonpath([candidate, root]) == root:
                return folder
        except ValueError:
            continue
    return None


def _journal_file_for(folder):
    """Pfad des Sync-Journals eines Ordners (aus der Config oder per Glob).

    Ohne konfigurierten (und vorhandenen) Journalpfad ist nur GENAU EIN
    ``.sync_*.db``-Treffer akzeptabel. Bei mehreren Kandidaten würde eine
    blinde Wahl die Dehydrierungsfreigabe gegen ein fremdes oder veraltetes
    Journal prüfen — dann lieber geschlossen ablehnen.
    """
    if folder["journal"]:
        candidate = os.path.join(folder["path"], folder["journal"])
        if os.path.exists(candidate):
            return candidate
    hits = sorted(glob.glob(os.path.join(folder["path"], ".sync_*.db")))
    if len(hits) > 1:
        raise RuntimeError(
            "mehrere Sync-Journale in %s gefunden — Dehydrierung abgelehnt"
            % folder["path"])
    return hits[0] if hits else None


def _load_journal_entries(folder):
    """Lädt alle Datei-Einträge des Sync-Journals: {relpfad: (größe, mtime)}.

    Der laufende Client hält sein Journal mit locking_mode=EXCLUSIVE gesperrt —
    direkt lesen geht nicht. Darum wird das Journal (plus WAL/SHM) zuerst als
    APFS-Klon kopiert (cp -c: quasi kostenlos, kein echtes Kopieren) und die
    Kopie gelesen. shutil.copy2 ist der Fallback für Nicht-APFS-Volumes.
    """
    import shutil
    import sqlite3
    import subprocess
    import tempfile

    source = _journal_file_for(folder)
    if not source:
        raise RuntimeError(
            "kein Sync-Journal in %s gefunden — Dehydrierung abgelehnt" % folder["path"])
    tmpdir = tempfile.mkdtemp(prefix="ncpin-journal-")
    try:
        base = os.path.join(tmpdir, os.path.basename(source))
        for ext in ("", "-wal", "-shm"):
            src = source + ext
            if not os.path.exists(src):
                continue
            cloned = subprocess.run(
                ["/bin/cp", "-c", src, base + ext],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
            if not cloned:
                shutil.copy2(src, base + ext)
        entries = {}
        try:
            # Kopie bewusst beschreibbar öffnen: SQLite muss das mitkopierte
            # WAL in die Kopie einspielen dürfen; das Original bleibt unberührt.
            conn = sqlite3.connect(base)
            try:
                rows = conn.execute("SELECT path, filesize, modtime FROM metadata")
                for path, filesize, modtime in rows:
                    entries[path] = (filesize, modtime)
            finally:
                conn.close()
        except sqlite3.Error as exc:
            raise RuntimeError(
                "Sync-Journal nicht lesbar (%s) — Dehydrierung abgelehnt" % exc)
        return entries
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


def _journal_entry_for(logical, rename_ctx):
    """Journal-Eintrag (größe, mtime) einer Datei oder None.

    macOS liefert Dateinamen mal NFD, mal NFC; das Journal speichert die
    Server-Schreibweise. Darum werden beide Normalformen probiert.
    """
    import unicodedata
    folder = _suffix_folder_for(logical, rename_ctx)
    if folder is None:
        return None
    cache = rename_ctx["journal_cache"]
    key = folder["path"]
    if key not in cache:
        cache[key] = _load_journal_entries(folder)
    entries = cache[key]
    rel = os.path.relpath(canonical_path(logical), canonical_path(folder["path"]))
    for candidate in (rel,
                      unicodedata.normalize("NFC", rel),
                      unicodedata.normalize("NFD", rel)):
        if candidate in entries:
            return entries[candidate]
    return None


def _require_synced(logical, rename_ctx, dirfd=None, name=None):
    """Wirft RuntimeError, wenn die Datei nicht fertig gesynct ist.

    Die Engine akzeptiert den Dehydrierungs-Rename nur, wenn mtime und Größe
    exakt zum Journal passen (discovery.cpp) — sonst ignoriert sie ihn still.
    Diese Vorprüfung macht daraus einen ehrlichen Fehler statt eines No-ops.

    Reihenfolge ist hier wichtig: Zuerst der Journal-Eintrag, DANACH die
    Metadaten der Datei. Beim ersten Aufruf wird das Journal geklont und
    ausgelesen; das dauert, und in dieser Zeit kann der Nutzer die Datei noch
    speichern. Ein vorher gelesenes stat wäre dann veraltet, und ncpin würde
    einen inzwischen geänderten Inhalt freigeben, den der Client anschließend
    still ignoriert. ``dirfd``/``name`` lesen die Metadaten relativ zum
    geöffneten Verzeichnis (openat-Semantik), also unabhängig davon, ob der
    Pfad zwischenzeitlich umgehängt wurde.
    """
    entry = _journal_entry_for(logical, rename_ctx)
    if entry is None:
        raise RuntimeError(
            "nicht im Sync-Journal (noch nicht hochgeladen?) — Dehydrierung abgelehnt")
    filesize, modtime = entry
    if dirfd is None:
        st = os.stat(logical)
    else:
        st = os.stat(name, dir_fd=dirfd, follow_symlinks=False)
    if st.st_size != filesize or int(st.st_mtime) != int(modtime):
        raise RuntimeError(
            "lokale Änderung noch nicht gesynct — Dehydrierung abgelehnt")


# Verzeichnisse während der Rekursion sicher öffnen: O_NOFOLLOW macht Prüfung
# und Öffnen zu EINEM Systemaufruf — ein Verzeichnis, das zwischenzeitlich durch
# einen Symlink ersetzt wurde, lässt sich damit gar nicht erst öffnen (kein
# Zeitfenster zwischen islink-Check und Zugriff).
_O_DIR_NOFOLLOW = os.O_RDONLY | os.O_NOFOLLOW | getattr(os, "O_DIRECTORY", 0)

# macOS-Flag für renameatx_np: Rename schlägt mit EEXIST fehl, statt ein
# vorhandenes Ziel still zu ersetzen (POSIX-rename würde es überschreiben).
_RENAME_EXCL = 0x00000004
_LIBC = None


def _libc():
    """Lädt die C-Bibliothek einmalig (für renameatx_np); lazy wie subprocess."""
    global _LIBC
    if _LIBC is None:
        import ctypes
        lib = ctypes.CDLL(None, use_errno=True)
        lib.renameatx_np.argtypes = [ctypes.c_int, ctypes.c_char_p,
                                     ctypes.c_int, ctypes.c_char_p,
                                     ctypes.c_uint]
        lib.renameatx_np.restype = ctypes.c_int
        _LIBC = lib
    return _LIBC


def _rename_excl_at(dirfd, source_name, target_name):
    """Benennt innerhalb eines geöffneten Verzeichnisses exklusiv um.

    renameatx_np(RENAME_EXCL) bricht mit EEXIST ab, wenn das Ziel inzwischen
    existiert — ein parallel (z.B. vom Client) erzeugter Gegenpfad wird also
    nie still überschrieben, sondern als kontrollierter Fehler gemeldet.
    """
    import ctypes
    import errno
    rc = _libc().renameatx_np(dirfd, os.fsencode(source_name),
                              dirfd, os.fsencode(target_name), _RENAME_EXCL)
    if rc != 0:
        err = ctypes.get_errno()
        if err == errno.EEXIST:
            raise RuntimeError(
                "Zielname %s existiert inzwischen — Rename abgebrochen"
                % target_name)
        raise OSError(err, os.strerror(err), target_name)


def _lexists_at(dirfd, name):
    """os.path.lexists relativ zu einem geöffneten Verzeichnis."""
    try:
        os.stat(name, dir_fd=dirfd, follow_symlinks=False)
        return True
    except OSError:
        return False


def _open_canonical_dir(dirpath):
    """Öffnet ein bereits kanonisches Verzeichnis Komponente für Komponente.

    Warum nicht einfach os.open(dirpath, O_NOFOLLOW)? Weil O_NOFOLLOW nur die
    LETZTE Komponente eines Pfads schützt. Wird nach der Grenzprüfung
    (checked_path) ein ZWISCHENverzeichnis durch einen Symlink nach außen
    ersetzt, folgt der Kernel diesem Symlink, und die Umbenennung landet
    außerhalb der registrierten Syncwurzel.

    Deshalb wird ab "/" jede einzelne Komponente relativ zum bereits
    geöffneten Verzeichnis mit O_NOFOLLOW nachgezogen. Der übergebene Pfad ist
    kanonisch (realpath), enthält also per Definition keinen Symlink; taucht
    doch einer auf, wurde er gerade untergeschoben und der Aufruf scheitert mit
    ELOOP statt auszubrechen. Rückgabe ist ein offener Verzeichnis-fd, den der
    Aufrufer schließen muss.
    """
    dirfd = os.open(os.sep, _O_DIR_NOFOLLOW)
    try:
        for part in dirpath.strip(os.sep).split(os.sep):
            if not part:
                continue
            nextfd = os.open(part, _O_DIR_NOFOLLOW, dir_fd=dirfd)
            os.close(dirfd)
            dirfd = nextfd
    except BaseException:
        os.close(dirfd)
        raise
    return dirfd


def _rename_pin_at(dirfd, dirpath, name, target, rename_ctx):
    """Setzt den Pin-Wunsch für genau eine Datei per Umbenennung um.

    Alle Dateisystemzugriffe laufen relativ zum geöffneten Verzeichnis-fd
    (openat-Semantik): Auch wenn der Pfad danach durch Symlinks ausgetauscht
    wird, wirken Prüfungen und Renames weiter im ursprünglichen, an der
    Syncwurzel verifizierten Verzeichnis. ``dirpath`` dient nur dem
    Journalabgleich und den Fehlertexten.
    """
    logical_name = name[:-len(SUFFIX)] if name.endswith(SUFFIX) else name
    placeholder_name = logical_name + SUFFIX
    logical = os.path.join(dirpath, logical_name)
    logical_exists = _lexists_at(dirfd, logical_name)
    placeholder_exists = _lexists_at(dirfd, placeholder_name)
    if logical_exists and placeholder_exists:
        raise RuntimeError(
            "logischer Name und Platzhalter existieren beide — nicht eindeutig")
    if target == "local":
        if logical_exists:
            return  # schon lokal (oder Download läuft bereits)
        _rename_excl_at(dirfd, placeholder_name, logical_name)
        return
    # target == "online"
    if not logical_exists:
        # Schon online-only — aber nur, wenn der Platzhalter wirklich ein
        # gültiger 1-Byte-Platzhalter ist. Ein Platzhalter mit anderer Größe
        # (Vollinhalt = vom Client ignorierter Dehydrierungswunsch, 0 Byte =
        # Datenmüll) wäre KEIN erledigter Pin-Wunsch -> ehrlicher Fehler.
        if placeholder_exists:
            pst = os.stat(placeholder_name, dir_fd=dirfd, follow_symlinks=False)
            if pst.st_size != PLACEHOLDER_SIZE:
                raise RuntimeError(
                    "Platzhalter %s hat %d statt %d Byte — Zustand unklar"
                    % (placeholder_name, pst.st_size, PLACEHOLDER_SIZE))
        return
    st = os.stat(logical_name, dir_fd=dirfd, follow_symlinks=False)
    if not stat.S_ISREG(st.st_mode):
        # Symlinks und Sonderdateien haben keinen dehydrierbaren Inhalt.
        raise RuntimeError("kein regulärer Dateiinhalt — Dehydrierung abgelehnt")
    if st.st_size == PLACEHOLDER_SIZE:
        # Sieht aus wie ein noch nicht hydrierter 1-Byte-Stub: nichts zu tun.
        return
    # Prüft gegen das Journal und liest Größe/mtime dabei frisch — unmittelbar
    # vor der Umbenennung, nicht aus dem oben gelesenen (dann evtl. veralteten)
    # Stat-Ergebnis.
    _require_synced(logical, rename_ctx, dirfd=dirfd, name=logical_name)
    _rename_excl_at(dirfd, logical_name, placeholder_name)


def _rename_pin_file(ondisk, target, rename_ctx):
    """Pin-Wunsch für eine einzelne Datei, verankert am Elternverzeichnis."""
    parent = os.path.dirname(ondisk)
    dirfd = _open_canonical_dir(parent)
    try:
        _rename_pin_at(dirfd, parent, os.path.basename(ondisk), target,
                       rename_ctx)
    finally:
        os.close(dirfd)


def _is_expected_race(exc):
    """True, wenn ein OSError nur das erwartete Verschwinde-Rennen beschreibt.

    Während der Rekursion kann ein Eintrag zwischen scandir und Zugriff
    gelöscht (ENOENT/ENOTDIR) oder durch einen Symlink ersetzt worden sein
    (ELOOP, weil O_NOFOLLOW ihn nicht öffnet). Nur das darf still übergangen
    werden. Jeder andere Fehler — etwa fehlende Rechte oder ein E/A-Fehler —
    bedeutet, dass eine sichtbare Datei NICHT umbenannt wurde, und muss
    gemeldet werden; sonst endet der Lauf fälschlich mit Exit 0.
    """
    import errno
    return exc.errno in (errno.ENOENT, errno.ENOTDIR, errno.ELOOP)


def _rename_pin_tree(dirfd, dirpath, target, rename_ctx, skipped, counted):
    """Rekursive Ordner-Abarbeitung über Verzeichnis-fds (openat-Semantik).

    Sichtbare reguläre Dateien werden umbenannt; versteckte Einträge und
    Symlinks fliegen raus. Unterverzeichnisse werden mit O_NOFOLLOW relativ
    zum Eltern-fd geöffnet: Ein während des Laufs durch einen Symlink
    ersetztes Verzeichnis lässt sich so nicht öffnen, die Traversierung kann
    die geprüfte Syncwurzel also nicht verlassen (frühere os.walk-Variante:
    Symlink-Check und Abstieg waren getrennte Schritte mit Zeitfenster).
    """
    for entry in sorted(os.scandir(dirfd), key=lambda e: e.name):
        name = entry.name
        if name.startswith("."):
            continue
        try:
            if entry.is_symlink():
                continue
            if entry.is_dir(follow_symlinks=False):
                subfd = os.open(name, _O_DIR_NOFOLLOW, dir_fd=dirfd)
                try:
                    _rename_pin_tree(subfd, os.path.join(dirpath, name),
                                     target, rename_ctx, skipped, counted)
                finally:
                    os.close(subfd)
            elif entry.is_file(follow_symlinks=False):
                counted[0] += 1
                _rename_pin_at(dirfd, dirpath, name, target, rename_ctx)
        except RuntimeError as exc:
            skipped.append(str(exc))
        except OSError as exc:
            if _is_expected_race(exc):
                continue
            # Echter Fehlschlag (z.B. EPERM, EIO): in die Fehlerliste, damit
            # rename_do_action ihn als Laufzeitfehler meldet.
            skipped.append("%s: %s" % (name, exc.strerror or exc))


def rename_do_action(ondisk, target, rename_ctx, roots):
    """Pendant zu do_action() für den Rename-Transport.

    Ordner werden von ncpin selbst rekursiv abgearbeitet (der Client machte
    das früher serverseitig des Sockets). Einzelne nicht dehydrierbare Dateien
    überspringen die Schleife; am Ende wird das als ein Fehler gemeldet.
    """
    ondisk = checked_path(ondisk, roots)
    if not client_process_running():
        raise RuntimeError(
            "Nextcloud-Client läuft nicht — Pin-Wunsch würde erst beim "
            "nächsten Start verarbeitet")
    if os.path.isdir(ondisk):
        skipped = []
        counted = [0]
        # Wurzel des Teilbaums symlinkfrei öffnen: Ab hier arbeitet die
        # Rekursion nur noch relativ zu geöffneten Verzeichnissen weiter.
        dirfd = _open_canonical_dir(ondisk)
        try:
            _rename_pin_tree(dirfd, ondisk, target, rename_ctx, skipped,
                             counted)
        finally:
            os.close(dirfd)
        if skipped:
            raise RuntimeError("%d von %d Datei(en) übersprungen — z.B.: %s"
                               % (len(skipped), counted[0], skipped[0]))
        return
    _rename_pin_file(ondisk, target, rename_ctx)


def rename_wait_for_state(orig_path, target, timeout, roots):
    """Pendant zu wait_for_state(): pollt den Dateisystem-Zustand.

    exact=True: --wait darf Erfolg nur nach vollständiger Traversierung
    melden — eine Stichprobe könnte fertige Dateien am Anfang sehen und
    unfertige hinter dem Deckel übersehen.
    """
    start = time.time()
    while time.time() - start < timeout:
        ondisk = resolve_ondisk(orig_path)
        if ondisk is None:
            time.sleep(0.5)
            continue
        if rename_query_state(ondisk, roots, exact=True) == target:
            return True
        time.sleep(0.5)
    return False



class PathOutsideRoots(ValueError):
    """Ein aufgeloester Pfad liegt ausserhalb aller registrierten Syncwurzeln."""


def merge_exit_code(current, new):
    """Zentrale Exit-Code-Prioritaet bei mehreren Pfad-Argumenten.

    Die READMEs definieren Exit 3 fuer "ein/mehrere Pfade nicht gefunden oder
    ausserhalb". Ein bereits erkannter Pfadfehler (3) darf deshalb nicht durch
    einen spaeteren Laufzeitfehler (1) eines anderen Pfads ueberschrieben
    werden — sonst hinge der Exit-Code von der Argument-Reihenfolge ab.
    Prioritaet: 3 (Pfadfehler) > 1 (Laufzeitfehler) > 0 (ok).
    """
    priority = {0: 0, 1: 1, 3: 2}
    if priority.get(new, 0) > priority.get(current, 0):
        return new
    return current


def canonical_path(path):
    """Expandiert Nutzerpfade und loest Symlinks fuer Sicherheitsvergleiche."""
    return os.path.realpath(os.path.abspath(os.path.expanduser(path)))


def canonical_roots(roots):
    """Kanonisiert und dedupliziert die vom Client registrierten Wurzeln."""
    result = []
    for root in roots:
        canonical = canonical_path(root)
        if canonical not in result:
            result.append(canonical)
    return result


def in_any_folder(path, roots):
    """True, wenn der reale Pfad in einer realen registrierten Wurzel liegt."""
    candidate = canonical_path(path)
    for root in roots:
        canonical_root = canonical_path(root)
        try:
            if os.path.commonpath([candidate, canonical_root]) == canonical_root:
                return True
        except ValueError:
            # Unterschiedliche Laufwerke/Pfadformen koennen keine Zugehoerigkeit
            # bilden. Auf macOS selten, aber kontrolliert ablehnen statt crashen.
            continue
    return False


def checked_path(path, roots):
    """Liefert den kanonischen Pfad oder verweigert die Syncroot-Grenze."""
    canonical = canonical_path(path)
    if "\n" in canonical or "\r" in canonical:
        raise PathOutsideRoots("Pfad enthaelt Zeilenumbruch")
    if not in_any_folder(canonical, roots):
        raise PathOutsideRoots("nicht in einem Nextcloud-Ordner")
    return canonical


def list_entries(folder, roots):
    """Listet die sichtbaren Eintraege eines Ordners als logische Namen.

    Fuer das Auswahlmenue der Toolbar-App (siehe README): der Nutzer klickt die
    App in einem Nextcloud-Ordner an und bekommt dessen Inhalt zur Auswahl. Regeln:
      - dehydrierte Platzhalter "<name>.nextcloud" werden auf "<name>" verkuerzt
        (ncpin loest beim Pin-Befehl ohnehin beide Schreibweisen auf),
      - versteckte Eintraege (".DS_Store", ".sync_*", …) fliegen raus,
      - alphabetisch sortiert + dedupliziert.
    Gibt eine Liste logischer Namen (ohne Pfad) zurueck.
    """
    # Unmittelbar vor dem Dateisystemzugriff erneut kanonisieren. Dadurch kann
    # ein Symlink unterhalb der Syncwurzel nicht in ein fremdes Verzeichnis
    # zeigen und dessen Namen ueber den Toolbar-Picker preisgeben.
    folder = checked_path(folder, roots)
    names = []
    seen = set()
    try:
        entries = sorted(os.listdir(folder))
    except OSError:
        return names
    for nm in entries:
        if nm.startswith("."):
            continue
        logical = nm[:-len(SUFFIX)] if nm.endswith(SUFFIX) else nm
        if logical and logical not in seen:
            seen.add(logical)
            names.append(logical)
    return names


def emit(results, as_json, quiet):
    """Gibt die Ergebnisse aus (JSON oder menschenlesbar)."""
    if as_json:
        print(json.dumps(results, ensure_ascii=False, indent=2))
        return
    if quiet:
        return
    labels = {"local": "lokal", "online": "online-only", "unknown": "unbekannt"}
    for r in results:
        if r.get("error"):
            print("✗ %s — %s" % (r["path"], r["error"]))
        elif r["op"] == "status":
            print("%-12s %s" % (labels.get(r["state"], r["state"]), r["path"]))
        else:
            arrow = "→ lokal" if r["target"] == "local" else "→ online-only"
            done = "" if not r.get("waited") else (" ✓" if r.get("reached") else " (Timeout)")
            print("%s  %s%s" % (arrow, r["path"], done))


COMMANDS = ("local", "online", "toggle", "status", "doctor", "list")
FLAG_OPTIONS = ("--json", "-q", "--quiet", "--wait")
VALUE_OPTIONS = ("--timeout", "--socket")


def normalize_cli_argv(argv):
    """Ordnet bekannte Optionen fuer argparse-Subparser kompatibel ein.

    Apples Python 3.9 kann ``parse_intermixed_args`` nicht mit Subparsern
    kombinieren. Darum werden Optionen vor bzw. zwischen Pfaden stabil vor die
    Pfad-Positionals des gewaehlten Befehls geschoben. ``--`` bleibt die klare
    Grenze fuer Pfade, die selbst mit einem Bindestrich beginnen.
    """
    original = list(argv)
    before = []
    global_options = []
    command = None
    index = 0

    while index < len(original):
        token = original[index]
        if token in COMMANDS:
            command = token
            index += 1
            break
        if token in ("-h", "--help", "--version"):
            global_options.append(token)
            index += 1
            continue
        if token in FLAG_OPTIONS:
            before.append(token)
            index += 1
            continue
        if token in VALUE_OPTIONS:
            before.append(token)
            if index + 1 < len(original):
                before.append(original[index + 1])
                index += 2
            else:
                index += 1
            continue
        if any(token.startswith(option + "=") for option in VALUE_OPTIONS):
            before.append(token)
            index += 1
            continue
        # Ein unbekanntes Token vor dem Subcommand soll argparse selbst mit
        # Exit 2 melden; seine moegliche Arity duerfen wir hier nicht erraten.
        return original

    if command is None:
        return original

    options = []
    paths = []
    used_separator = False
    while index < len(original):
        token = original[index]
        if token == "--":
            used_separator = True
            paths.extend(original[index + 1:])
            break
        if token == "--version":
            global_options.append(token)
            index += 1
            continue
        if token in FLAG_OPTIONS or token in ("-h", "--help"):
            options.append(token)
            index += 1
            continue
        if token in VALUE_OPTIONS:
            options.append(token)
            if index + 1 < len(original):
                options.append(original[index + 1])
                index += 2
            else:
                index += 1
            continue
        if any(token.startswith(option + "=") for option in VALUE_OPTIONS):
            options.append(token)
            index += 1
            continue
        if token.startswith("-"):
            # Unbekannte Option bewusst beim Subparser lassen, damit sie vor
            # jedem Socketzugriff als Aufruffehler endet.
            options.append(token)
        else:
            paths.append(token)
        index += 1

    normalized = global_options + [command] + before + options
    if used_separator:
        normalized.append("--")
    normalized.extend(paths)
    return normalized


def add_output_options(parser):
    """Gemeinsame, tatsaechlich ausgewertete Ausgabe-/Socketoptionen."""
    parser.add_argument("--json", action="store_true",
                        help="maschinenlesbare JSON-Ausgabe")
    parser.add_argument("-q", "--quiet", action="store_true",
                        help="keine normale Ausgabe (nur Exit-Code)")
    parser.add_argument("--socket", help="Socket-Pfad strikt ueberschreiben")


def build_parser():
    """Baut die exakte Befehlsgrammatik der CLI."""
    ap = argparse.ArgumentParser(
        prog="ncpin",
        description="Nextcloud-VFS-Pin per Kommandozeile (am FinderSync-Menü vorbei).",
        epilog="Beispiele:\n"
               "  ncpin local  ~/Nextcloud/Film.mp4        # lokal holen (hydrieren)\n"
               "  ncpin online ~/Nextcloud/Film.mp4        # Speicher freigeben\n"
               "  ncpin toggle ~/Nextcloud/Ordner          # umschalten (rekursiv)\n"
               "  ncpin status --json ~/Nextcloud/*.pdf    # Zustand maschinenlesbar\n"
               "  ncpin list   ~/Nextcloud/Ordner          # Ordnerinhalt (logische Namen)\n"
               "  ncpin doctor                             # Client/Socket prüfen",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("--version", action="version", version="ncpin 1.3.1")
    ap.set_defaults(paths=[], json=False, quiet=False, socket=None,
                    wait=False, timeout=30.0)
    subparsers = ap.add_subparsers(dest="command", required=True)

    for command in ("local", "online", "toggle"):
        command_parser = subparsers.add_parser(command)
        add_output_options(command_parser)
        command_parser.add_argument("--wait", action="store_true",
                                    help="bis zum Zielzustand warten")
        command_parser.add_argument(
            "--timeout", type=float, default=30.0, metavar="SEK",
            help="max. Wartezeit fuer --wait (Standard 30s)")
        command_parser.add_argument(
            "paths", nargs="+",
            help="Datei(en)/Ordner im Nextcloud-Ordner")

    status_parser = subparsers.add_parser("status")
    add_output_options(status_parser)
    status_parser.add_argument(
        "paths", nargs="+", help="Datei(en)/Ordner im Nextcloud-Ordner")

    doctor_parser = subparsers.add_parser("doctor")
    add_output_options(doctor_parser)

    list_parser = subparsers.add_parser("list")
    add_output_options(list_parser)
    list_parser.add_argument(
        "paths", nargs=1, metavar="PFAD",
        help="genau ein Ordner im Nextcloud-Ordner")
    return ap


def main(argv):
    ap = build_parser()
    args = ap.parse_args(normalize_cli_argv(argv))

    # Transportwahl: zuerst die klassische Socket-API (Client bis v33), sonst
    # der Rename-Transport (Client v34+). Ein explizit gesetzter Socket
    # (--socket / NCPIN_SOCKET) bleibt strikt und fällt NIE auf den
    # Rename-Transport zurück — sonst würden Tests mit Fixture-Socket still
    # auf der echten Client-Konfiguration dieses Macs arbeiten.
    explicit_socket = args.socket is not None or bool(os.environ.get("NCPIN_SOCKET"))
    sock, discovered_roots = discover_socket_with_paths(args.socket)
    rename_ctx = None
    if not sock and not explicit_socket:
        rename_ctx = rename_transport_context()

    if sock:
        transport = "socket"
        roots = canonical_roots(discovered_roots)
    elif rename_ctx:
        transport = "rename"
        roots = canonical_roots(rename_ctx["roots"])
    else:
        transport = None
        roots = []

    # doctor: Diagnose ohne Pfade
    if args.command == "doctor":
        # Ohne Transport den plausibelsten Grund gleich mitliefern: Ab Client
        # v34 gibt es die Socket-API nicht mehr, und der Rename-Transport
        # braucht suffix-Ordner in der Client-Konfiguration (Helfer oben).
        removed_hint = None if transport else socket_api_removed_hint()
        client_running = client_process_running() if transport == "rename" else None
        if transport == "socket":
            responds = bool(roots)
        elif transport == "rename":
            responds = bool(client_running)
        else:
            responds = False
        info = {
            "transport": transport,
            "backend_ok": transport is not None,
            "socket": sock,
            "socket_ok": bool(sock),
            "client_responds": responds,
            "registered_folders": roots,
            "config": rename_ctx["config"] if rename_ctx else None,
            "suffix": SUFFIX,
            "client_app_version": installed_client_version(),
            "socket_api_removed": bool(removed_hint),
        }
        if args.json:
            print(json.dumps(info, ensure_ascii=False, indent=2))
        elif not args.quiet:
            print("Transport:        %s" % (transport or "KEINER"))
            print("Socket:           %s" % (sock or "—"))
            if rename_ctx:
                print("Config:           %s" % rename_ctx["config"])
            print("Client antwortet: %s" % ("ja" if responds else "nein"))
            print("Sync-Ordner:      %s" % (", ".join(roots) if roots else "—"))
            print("Suffix:           %s" % SUFFIX)
            print("Client-Version:   %s" % (info["client_app_version"] or "unbekannt"))
        if not transport:
            if removed_hint:
                sys.stderr.write("Fehler: %s\n" % removed_hint)
            else:
                sys.stderr.write("Fehler: kein Nextcloud-Socket gefunden und "
                                 "keine Client-Konfiguration mit suffix-VFS.\n")
            return 1
        if not responds:
            sys.stderr.write("Fehler: Client antwortet nicht (läuft Nextcloud?).\n")
            return 1
        return 0

    if not transport:
        removed_hint = socket_api_removed_hint()
        if removed_hint:
            sys.stderr.write("Fehler: %s\n" % removed_hint)
        else:
            sys.stderr.write("Fehler: kein Nextcloud-Socket gefunden und keine "
                             "Client-Konfiguration mit suffix-VFS — läuft der Client?\n")
        return 1

    if not roots:
        sys.stderr.write("Fehler: Nextcloud-Client antwortet nicht (läuft er?).\n")
        return 1

    # list: Inhalt EINES Ordners auflisten (fuer das Auswahlmenue der Toolbar-App).
    # Eigener Zweig, weil die Ausgabe anders aussieht (viele Namen statt 1 Zustand
    # pro Pfad). Reiner Filesystem-Lesevorgang, kein Socket-Befehl noetig.
    if args.command == "list":
        raw = args.paths[0]
        if not in_any_folder(raw, roots):
            sys.stderr.write("Fehler: nicht in einem Nextcloud-Ordner.\n")
            return 3
        folder = resolve_ondisk(raw)
        if folder is None:
            sys.stderr.write("Fehler: Ordner nicht gefunden.\n")
            return 3
        try:
            folder = checked_path(folder, roots)
            if not os.path.isdir(folder):
                sys.stderr.write("Fehler: Ordner nicht gefunden.\n")
                return 3
            names = list_entries(folder, roots)
        except PathOutsideRoots:
            sys.stderr.write("Fehler: nicht in einem Nextcloud-Ordner.\n")
            return 3
        if args.json:
            print(json.dumps({"folder": folder, "entries": names},
                             ensure_ascii=False, indent=2))
        elif not args.quiet:
            # eine logische Bezeichnung je Zeile -> direkt von AppleScript
            # (paragraphs of) bzw. Skripten weiterverarbeitbar.
            for n in names:
                print(n)
        return 0

    results = []
    exit_code = 0

    for raw in args.paths:
        # Pfad muss in einem Nextcloud-Ordner liegen — sonst nichts anfassen.
        if not in_any_folder(raw, roots):
            results.append({"path": raw, "op": args.command,
                            "error": "nicht in einem Nextcloud-Ordner"})
            exit_code = merge_exit_code(exit_code, 3)
            continue

        ondisk = resolve_ondisk(raw)
        if ondisk is None:
            results.append({"path": raw, "op": args.command,
                            "error": "Datei nicht gefunden"})
            exit_code = merge_exit_code(exit_code, 3)
            continue

        try:
            ondisk = checked_path(ondisk, roots)
        except PathOutsideRoots as e:
            results.append({"path": raw, "op": args.command,
                            "error": str(e)})
            exit_code = merge_exit_code(exit_code, 3)
            continue

        try:
            if args.command == "status":
                if transport == "socket":
                    state = query_state(sock, ondisk, roots)
                else:
                    state = rename_query_state(ondisk, roots)
                results.append({"path": ondisk, "op": "status", "state": state})
                continue

            # Zielzustand bestimmen
            if args.command == "local":
                target = "local"
            elif args.command == "online":
                target = "online"
            else:  # toggle
                if transport == "socket":
                    cur = query_state(sock, ondisk, roots)
                else:
                    # exact: fuer die Richtungsentscheidung zaehlt der ganze
                    # Baum, nicht die schnelle Anzeige-Stichprobe.
                    cur = rename_query_state(ondisk, roots, exact=True)
                if cur == "unknown":
                    # Zustand nicht ermittelbar (z.B. Client im Fehlerzustand) —
                    # lieber Fehler melden als blind hydrieren oder dehydrieren.
                    results.append({"path": ondisk, "op": args.command,
                                     "error": "Zustand nicht ermittelbar (toggle abgebrochen)"})
                    exit_code = merge_exit_code(exit_code, 1)
                    continue
                target = "online" if cur == "local" else "local"

            if transport == "socket":
                do_action(sock, ondisk, target, roots)
            else:
                rename_do_action(ondisk, target, rename_ctx, roots)
            rec = {"path": ondisk, "op": args.command, "target": target}

            if args.wait:
                if transport == "socket":
                    reached = wait_for_state(sock, raw, target, args.timeout, roots)
                else:
                    reached = rename_wait_for_state(raw, target, args.timeout, roots)
                rec["waited"] = True
                rec["reached"] = reached
                if not reached:
                    exit_code = merge_exit_code(exit_code, 1)
            results.append(rec)
        except PathOutsideRoots as e:
            # Der Pfad kann sich zwischen Aufloesung und Transportoperation
            # aendern (z.B. ausgetauschter Symlink). Auch dann Exit 3, keine Aktion.
            results.append({"path": ondisk, "op": args.command,
                            "error": str(e)})
            exit_code = merge_exit_code(exit_code, 3)
        except RuntimeError as e:
            # Rename-Transport lehnt ab (nicht gesynct, Client fehlt, Journal
            # unlesbar): ehrlicher Laufzeitfehler je Pfad, weiter geht's.
            results.append({"path": ondisk, "op": args.command,
                            "error": str(e)})
            exit_code = merge_exit_code(exit_code, 1)
        except OSError as e:
            # Verbindungs-/Dateisystemfehler waehrend der Verarbeitung: sauberen
            # Fehlereintrag anhaengen und naechsten Pfad verarbeiten statt crashen.
            results.append({"path": ondisk, "op": args.command,
                             "error": "Transportfehler: %s" % e})
            exit_code = merge_exit_code(exit_code, 1)

    emit(results, args.json, args.quiet)
    return exit_code


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)

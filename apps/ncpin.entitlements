<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Pflicht unter Hardened Runtime: erlaubt der App, AppleEvents an andere
	     Apps (Finder) zu senden. Ohne dieses Entitlement blockt der Hardened
	     Runtime die Events VOR TCC -> Fehler -1743, ganz ohne Erlauben-Prompt.
	     Fuer notarisierte Developer-ID-Apps zulaessig. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
